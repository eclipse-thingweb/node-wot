        "node-opcua-variant": "2.187.0",
        "rxjs": "^5.5.11",
        "url": "^0.11.4"
    },
    "scripts": {
        "build": "tsc -b",
        "check:types:test": "tsc -p tsconfig.test.json",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"**/*.json\"",
        "ncu:opcua": "npx node-opcua-versions@latest bump -w --all --install",
        "test": "mocha",
        "test:verbose": "mocha --require ./test/enable-verbose-reports.js"
    },
    "bugs": {
