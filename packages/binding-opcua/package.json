{
    "name": "@node-wot/binding-opcua",
    "version": "1.0.0-SNAPSHOT.0",
    "description": "opcua client protocol binding for node-wot",
    "author": "Eclipse Thingweb <thingweb-dev@eclipse.org> (https://thingweb.io/)",
