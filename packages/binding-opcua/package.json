    "devDependencies": {
        "should": "^13.2.3",
        "web-streams-polyfill": "^4.0.0"
    },
    "dependencies": {
        "@node-wot/core": "1.0.0-SNAPSHOT.0",
        "ajv": "^8.11.0",
        "ajv-formats": "^2.1.1",
        "env-paths": "2.2.1",
        "node-opcua": "2.187.10",
        "node-opcua-address-space": "2.187.9",
        "node-opcua-basic-types": "2.187.0",
        "node-opcua-binary-stream": "2.187.0",
        "node-opcua-certificate-manager": "2.187.9",
        "node-opcua-client": "2.187.9",
