        "node-opcua-crypto": "6.2.3",
        "node-opcua-data-model": "2.187.0",
        "node-opcua-data-value": "2.187.9",
        "node-opcua-date-time": "2.187.0",
        "node-opcua-debug": "2.186.7",
        "node-opcua-extension-object": "2.187.0",
        "node-opcua-factory": "2.187.0",
        "node-opcua-json": "2.187.10",
        "node-opcua-nodeid": "2.187.0",
        "node-opcua-numeric-range": "2.187.0",
        "node-opcua-pseudo-session": "2.187.9",
        "node-opcua-service-browse": "2.187.9",
